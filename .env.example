# Copy to .env.local and adjust. Every variable is optional in local development.

# --- Database ---
# Unset → embedded PGlite at .data/pglite (in-memory under tests).
# With docker compose: postgres://throne:throne@localhost:5432/throne
DATABASE_URL=

# --- Payments (Stripe). Unset STRIPE_SECRET_KEY → fake payments (no network). ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email. Unset RESEND_API_KEY → dev outbox (.data/outbox, /dev/outbox). ---
RESEND_API_KEY=
EMAIL_FROM="The Throne <throne@localhost>"

# --- Moderation ---
ANTHROPIC_API_KEY=
# enabled | disabled. "disabled" (dev only) = regex + banned terms, no LLM call.
MODERATION_LLM=disabled

# --- App ---
APP_URL=http://localhost:3000
# Salt for hashing IPs, device ids and ban values. Use a long random value in production.
HASH_SALT=dev-hash-salt-change-me
# HMAC secret for signed reclaim/unsubscribe tokens. Use a long random value in production.
TOKEN_SECRET=dev-token-secret-change-me
# Bearer token for GET /api/cron/{job}
CRON_SECRET=dev-cron-secret
# 1 = run jobs on in-process timers (src/instrumentation.ts); 0 = rely on /api/cron only
JOBS_INPROCESS=1

# --- Admin ---
# Comma-separated list of admin emails
ADMIN_EMAILS=admin@localhost
# One-time token to register the first passkey
ADMIN_BOOTSTRAP_TOKEN=dev-bootstrap-token
# 1 = allow passwordless admin login in development (never in production)
ADMIN_DEV_LOGIN=1
